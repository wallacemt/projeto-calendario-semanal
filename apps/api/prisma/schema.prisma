// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum AuthProvider {
  GOOGLE
  GITHUB
}

// ADR-03 — "branch de estação" é Calendar keyed por (season, year), não
// versionamento tipo git. Weekday inclui BACKLOG = aba "extra" do legado
// (ADR-08): entrada sem dia fixo na semana.
enum Season {
  WINTER
  SPRING
  SUMMER
  FALL
}

enum Weekday {
  MON
  TUE
  WED
  THU
  FRI
  SAT
  SUN
  BACKLOG
}

enum EntryStatus {
  PLANNED
  WATCHING
  PAUSED
  COMPLETED
  DROPPED
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  username      String   @unique
  passwordHash  String?
  avatarUrl     String?  @default("https://djitwkagdqgbhanenonk.supabase.co/storage/v1/object/public/aniweek/avatar.png")
  bio           String?
  emailVerified Boolean  @default(false)
  createdAt     DateTime @default(now())

  calendars Calendar[]
  watched   WatchedAnime[]

  // null = modo "auto" (segue a estação atual — ver ThemesService.getActive).
  // onDelete: SetNull em vez de Cascade: apagar o tema ativo não pode
  // derrubar o User junto, só volta ele pro modo auto.
  activeThemeId String?
  activeTheme   Theme?  @relation("ActiveTheme", fields: [activeThemeId], references: [id], onDelete: SetNull)
  themes        Theme[] @relation("UserThemes")

  // Museu em destaque (M8.1) — mesmo padrão de activeThemeId: null = modo
  // "auto" (MuseumService.resolveFeaturedId cai pro assistido mais recente).
  // onDelete: SetNull — apagar o item fixado só devolve o museu pro auto,
  // não derruba o User.
  featuredWatchedAnimeId String?
  featuredWatchedAnime   WatchedAnime? @relation("FeaturedWatched", fields: [featuredWatchedAnimeId], references: [id], onDelete: SetNull)

  refreshTokens RefreshToken[]
  oauthAccounts OAuthAccount[]
}

model OAuthAccount {
  id                String       @id @default(cuid())
  userId            String
  provider          AuthProvider
  providerAccountId String
  user              User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Espelho local do Jikan (M3 — ADR-06). Uma linha por anime, upsertada só
// quando alguém abre o detalhe (GET /animes/:malId) — a busca não persiste.
model Anime {
  id             String   @id @default(cuid())
  malId          Int      @unique
  title          String
  imageUrl       String?
  synopsis       String?
  episodes       Int?
  genres         Json?
  malUrl         String?
  // Onde o usuário assiste (M6, fora do blueprint) — só exibe o botão
  // "Acessar anime" no board quando preenchido.
  linkAccess     String?
  // M6: quando true, getByMalId (upsert do Jikan) pula a atualização dos
  // campos espelhados — protege uma edição manual (PATCH /animes/:id) de ser
  // sobrescrita no próximo refetch da API externa.
  manuallyEdited Boolean  @default(false)
  cachedAt       DateTime @default(now())

  entries CalendarEntry[]
  watched WatchedAnime[]
}

// Museu — registro PERMANENTE, independente do ciclo de vida do calendário
// (M8/RF-09). Ao contrário de CalendarEntry (que pertence a UM Calendar de
// UMA estação), WatchedAnime não tem calendarId: sobrevive mesmo se o
// usuário apagar a estação em que assistiu. @@unique([userId, animeId])
// também é o que torna "marcar como assistido de novo" uma decisão de
// design (upsert vs. rejeitar) em vez de deixar duplicar linha.
model WatchedAnime {
  id            String   @id @default(cuid())
  userId        String
  animeId       String
  rating        Int? // 1..10
  comment       String?
  completedAt   DateTime @default(now())
  // "Quando" narrativo (M8.1) — opcional e independente de completedAt:
  // completedAt é o timestamp real do registro (usado nas stats/ordenação),
  // watchedSeason/watchedYear é o que o usuário lembra/declara (ex.: "vi no
  // verão de 2019"), só pra exibição. Nenhum dos dois obriga o outro.
  watchedSeason Season?
  watchedYear   Int?

  user            User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  anime           Anime  @relation(fields: [animeId], references: [id])
  featuredByUsers User[] @relation("FeaturedWatched")

  @@unique([userId, animeId])
  @@index([userId, completedAt])
}

// "Branch de estação" (ADR-03) = 1 calendário por (user, season, year).
// "Trazer animes adiante" entre estações (M6) é uma cópia explícita de
// CalendarEntry para o Calendar novo, não uma operação de versionamento.
model Calendar {
  id        String   @id @default(cuid())
  userId    String
  season    Season
  year      Int
  createdAt DateTime @default(now())

  user    User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  entries CalendarEntry[]

  @@unique([userId, season, year]) // AC-03: 1 calendário por temporada por usuário
}

// Card do board. Progresso vive AQUI (por entrada) — é o que permite a cópia
// entre estações (M6) preservar ou resetar `currentEpisode` sem tocar em Anime.
model CalendarEntry {
  id             String      @id @default(cuid())
  calendarId     String
  animeId        String
  weekday        Weekday
  position       Int
  currentEpisode Int         @default(0)
  totalEpisodes  Int? // snapshot no momento da adição (§8 do blueprint)
  status         EntryStatus @default(PLANNED)
  createdAt      DateTime    @default(now())

  calendar Calendar @relation(fields: [calendarId], references: [id], onDelete: Cascade)
  anime    Anime    @relation(fields: [animeId], references: [id])

  @@unique([calendarId, animeId]) // sem anime duplicado no mesmo calendário
  @@index([calendarId, weekday, position]) // leitura ordenada do board
}

// Tema custom do usuário (M7 — RF-08/ADR-09). O MVP (M0) já cobria o caso
// "1 paleta fixa por estação" via CSS vars ([data-season] em tokens.css) —
// aqui é só a camada de override por cima disso: accent/accent2 (não a
// paleta completa) porque é só isso que o editor (design M7) expõe pro
// usuário mexer. bgImageUrl fica solto opcional: sem ele, o board continua
// usando o bg padrão da estação (assets/seasons/*).
//
// Simplificação deliberada vs. o esboço original do blueprint (`colors
// Json`): 2 colunas fixas em vez de um blob JSON — o shape é conhecido e
// pequeno, JSON só compraria "flexibilidade" que não existe UI pra usar.
model Theme {
  id         String   @id @default(cuid())
  userId     String
  name       String
  accent     String // cor de destaque primária (hex #RRGGBB)
  accent2    String // cor de destaque secundária (hex #RRGGBB) — usada em gradientes
  bgImageUrl String?
  season     Season? // preenchido = aplicado automaticamente no modo "auto" quando bate a estação
  createdAt  DateTime @default(now())

  user           User   @relation("UserThemes", fields: [userId], references: [id], onDelete: Cascade)
  activeForUsers User[] @relation("ActiveTheme")

  @@unique([userId, season]) // no máx. 1 tema "pinado" por estação (NULL não conta — Postgres trata múltiplos NULL como distintos)
  @@index([userId])
}
