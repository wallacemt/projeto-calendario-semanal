# App
NODE_ENV=development
PORT=3000

# Front — obrigatório no M1: usado em CORS (credentials) e no redirect pós-OAuth
FRONTEND_URL="http://localhost:5173"

# URL pública desta API (com https em prod) — obrigatório: monta o
# callbackURL absoluto do OAuth (Google/GitHub). Nunca deixe relativo, quebra
# atrás de reverse proxy (LSF-2026-005).
API_URL="http://localhost:3000"

# Database (Postgres) — obrigatório
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/aniweek?schema=public"

# Redis — cache Jikan + rate limiting (M0.4/M3)
REDIS_URL="redis://localhost:6379"

# JWT — access/refresh (M1) — obrigatório
JWT_SECRET="troque-por-um-segredo-forte-em-producao"
# Secret separado dos JWTs auxiliares (verify-email/password-reset/oauth-state)
# — nunca reutilize o valor de JWT_SECRET aqui (LSF-2026-002).
JWT_AUX_SECRET="troque-por-outro-segredo-forte-e-diferente-em-producao"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN_DAYS=7

# OAuth — login social (M1, ADR-11). Opcional: provedor sem client id/secret
# responde 503 na rota /auth/oauth/:provider em vez de derrubar o boot.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# Supabase Storage — upload de imagem (ADR-07, M2+)
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""

# Resend — envio de email (ADR-05, M1). Sem key: MailService loga e segue
# (best-effort, nunca derruba o fluxo de registro/reset).
RESEND_API_KEY=""
RESEND_FROM_EMAIL="no-reply@aniweek.app"
