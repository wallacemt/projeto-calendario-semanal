# App
NODE_ENV=development
PORT=3000

# Database (Postgres) — obrigatório
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/aniweek?schema=public"

# Redis — cache Jikan + rate limiting (M0.4/M3)
REDIS_URL="redis://localhost:6379"

# JWT — access/refresh (M1)
JWT_SECRET=""
JWT_EXPIRES_IN="15m"

# OAuth — login social (M1, ADR-11)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# Supabase Storage — upload de imagem (ADR-07, M2+)
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""

# Resend — envio de email (ADR-05, M1)
RESEND_API_KEY=""
